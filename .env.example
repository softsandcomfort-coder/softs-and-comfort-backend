# Soft & Comfort dashboard — admin.softandcomfort.com
#
# Copy to .env.local for local development, or paste each line into
# Vercel -> Project -> Settings -> Environment Variables for production.
# Only the two secrets below need filling in; everything else is ready as-is.
# NEVER commit a filled-in copy of this file.

# --- Sanity (safe to expose) ---------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=3q7gveu7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_ADMIN_DATASET=admin
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Secrets (fill in) ----------------------------------------------------
# Editor token from sanity.io/manage -> API -> Tokens -> Add API token (Editor).
# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, never add to the storefront.
SANITY_API_TOKEN=

# Signs the admin login cookie. Use a different value locally and in production.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- URLs -----------------------------------------------------------------
# Storefront origins allowed to place orders (comma separated).
# Local dev: add http://localhost:5173 to the front of the list.
STOREFRONT_ORIGIN=https://www.softandcomfort.com,https://softandcomfort.com

# This dashboard's public URL — used in password-reset links.
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://admin.softandcomfort.com

# --- Email (optional) -----------------------------------------------------
# Needed only for password-reset and order emails. Leave blank to skip.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
