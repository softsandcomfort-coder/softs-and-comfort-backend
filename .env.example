NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_ADMIN_DATASET=admin
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Editor-scoped write token from sanity.io/manage -> API -> Tokens.
# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_.
SANITY_API_TOKEN=

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional, for password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Origins allowed to POST to /api/public/orders (comma separated)
STOREFRONT_ORIGIN=http://localhost:5173
